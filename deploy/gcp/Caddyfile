{$SITE_HOST} {
	encode zstd gzip
	# signed evidence photos the road authority opens come from the agent API
	reverse_proxy /media/* roadsense:8000
	reverse_proxy roadsense:7860
}

# the mock Halifax 311 inbox, so a demo viewer can mark a request repaired; only the app files requests
311.{$SITE_HOST} {
	encode zstd gzip
	@file method POST path /requests.json
	respond @file "Requests are filed by RoadSense, not from outside" 403
	reverse_proxy roadsense:8311
}
